# ==============================================================================
# PrivSight (PS-019) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in production and supply appropriate configuration.
# Do not commit .env with real secrets to version control.
# ==============================================================================

# --- APPLICATION & DATABASE SETTINGS ---
# Path to the persistent user authentication SQLite database.
# On persistent cloud storage (e.g. Docker volumes, AWS EBS), mount this directory.
PRIVSIGHT_AUTH_DB=data/users.db

# Environment mode: 'development' or 'production'
PRIVSIGHT_ENV=development

# --- CORS & SECURITY CONFIGURATION ---
# Comma-separated list of allowed origins for cross-origin requests.
# When frontend and backend share the same origin, defaults are sufficient.
PRIVSIGHT_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Enforce Secure flag on HttpOnly cookies (automatically enabled when request scheme is HTTPS).
# Set to 'true' in production behind HTTPS reverse proxy (e.g. NGINX, Cloudflare).
PRIVSIGHT_COOKIE_SECURE=false

# Session cookie lifetime configuration
PRIVSIGHT_SESSION_HOURS=24
PRIVSIGHT_REMEMBER_ME_DAYS=30

# --- SMTP EMAIL DELIVERY CONFIGURATION (OPTIONAL) ---
# When configured, password reset tokens and security alerts will be emailed to users.
# In local development without SMTP, reset tokens are securely recorded in server logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=security@privsight.io
SMTP_USE_TLS=true
