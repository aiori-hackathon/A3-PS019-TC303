{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "frontend/**"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/style.css",
      "destination": "/frontend/style.css"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
